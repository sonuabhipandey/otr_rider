# Copy this file to .env.local (local dev) and fill in the values.
# In Vercel: Project → Settings → Environment Variables (same names).

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase → Project Settings → API Keys → "anon" / "publishable" key (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys → "service_role" / "secret" key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the office PC automation sends as "Authorization: Bearer <key>".
# Generate a long random value (e.g. `openssl rand -hex 32`) and put the same value in automation/config.yaml.
AUTOMATION_UPLOAD_KEY=

# Secret Vercel Cron sends as "Authorization: Bearer <secret>" to /api/cron/purge-files (deletes CSV files
# older than 7 days). Generate a long random value; set it in Vercel too. Server only.
CRON_SECRET=
